<section class="tab {{tab.id}}{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <section class="flexrow section--resources">
    {{!-- Custom Resources --}}
    {{#each system.resources as |res r|}}
    <div class="attributes resource-tracker">
      {{#if @root.isPlay}}
	    {{#if res.label}}
      <h4 class="resource-name">
        <div>{{lookup (lookup @root.source.system.resources r) "label"}}</div>
      </h4>
      <div class="resource-value attribute-value flexrow">
        <input name="system.resources.{{res.name}}.value" type="text" value="{{lookup (lookup @root.source.system.resources r) "value"}}" placeholder="0">
        <span class="sep">/</span>
        <div>{{lookup (lookup @root.source.system.resources r) "max"}}</div>
      </div>
      {{/if}}
      {{else}}
      <h4 class="resource-name">
        <input name="system.resources.{{res.name}}.label" type="text" value="{{lookup (lookup @root.source.system.resources r) "label"}}"
          placeholder="{{res.placeholder}}">
      </h4>
      <div class="resource-value attribute-value flexrow">
        <input name="system.resources.{{res.name}}.value" type="text" value="{{lookup (lookup @root.source.system.resources r) "value"}}" placeholder="0">
        <span class="sep">/</span>
        <input name="system.resources.{{res.name}}.max" type="text" value="{{lookup (lookup @root.source.system.resources r) "max"}}" placeholder="0">
      </div>
      {{/if}}
      {{#if (or res.label (not @root.isPlay))}}
      <footer class="resource-footer flexrow">
        <label class="recharge checkbox">
          {{ localize 'DND4E.AbbreviationSR' }}
          <input name="system.resources.{{res.name}}.sr" type="checkbox" {{checked res.sr}} {{#if @root.isPlay}}disabled{{/if}}>
        </label>
        <label class="recharge checkbox">
          {{ localize 'DND4E.AbbreviationLR' }}
          <input name="system.resources.{{res.name}}.lr" type="checkbox" {{checked res.lr}} {{#if @root.isPlay}}disabled{{/if}}>
        </label>
      </footer>
      {{/if}}
    </div>
    {{/each}}
  </section>

  {{!-- Biographical Details --}}
  <section class="section--details">
    <h4 class="group-header">{{ localize 'DND4E.Details' }}</h4>
    <div class="flexrow details-columns">
      <div class="flexcol details-fluff">
        <div class="detail gender">
          <label for="gender">{{localize 'DND4E.Gender'}}:</label>
          {{#if isPlay}}
          <div class="gender" data-tooltip="{{localize 'DND4E.Gender'}}">{{document.system.details.gender}}</div>
          {{else}}
          {{formInput detailsFields.gender value=source.system.details.gender placeholder=(localize "DND4E.Gender")}}
          {{/if}}
        </div>
        <div class="detail age">
          <label for="age">{{localize 'DND4E.Age'}}:</label>
          {{#if isPlay}}
          <div class="age" data-tooltip="{{localize 'DND4E.Age'}}">{{document.system.details.age}}</div>
          {{else}}
          {{formInput detailsFields.age value=source.system.details.age placeholder=(localize "DND4E.Age")}}
          {{/if}}
        </div>
        <div class="detail alignment">
          <label for="alignment">{{localize 'DND4E.Alignment'}}:</label>
          {{#if isPlay}}
          <div class="alignment" data-tooltip="{{localize 'DND4E.Alignment'}}">{{document.system.details.alignment}}</div>
          {{else}}
          {{formInput detailsFields.alignment value=source.system.details.alignment placeholder=(localize "DND4E.Alignment")}}
          {{/if}}
        </div>
        <div class="detail height">
          <label for="height">{{localize 'DND4E.Height'}}:</label>
          {{#if isPlay}}
          <div class="height" data-tooltip="{{localize 'DND4E.Height'}}">{{document.system.details.height}}</div>
          {{else}}
          {{formInput detailsFields.height value=source.system.details.height placeholder=(localize "DND4E.Height")}}
          {{/if}}
        </div>
        <div class="detail weight">
          <label for="weight">{{localize 'DND4E.Weight'}}:</label>
          {{#if isPlay}}
          <div class="weight" data-tooltip="{{localize 'DND4E.Weight'}}">{{document.system.details.weight}}</div>
          {{else}}
          {{formInput detailsFields.weight value=source.system.details.weight placeholder=(localize "DND4E.Weight")}}
          {{/if}}
        </div>
      </div>

      <div class="flexcol details-mechanical">
        <div class="detail form-group size">
          <label>{{localize 'DND4E.Size'}}:</label>
          {{#if isPlay}}
          <div class="actor-size" data-tooltip="{{localize 'DND4E.Size'}}">{{lookup (lookup config.actorSizes document.system.details.size) "label"}}</div>
          {{else}}
          {{formInput detailsFields.size value=source.system.details.size}}
          {{/if}}
        </div>
        <div class="detail form-group origin">
          <label>{{localize 'DND4E.Origin.ThingOrigin' thing=(localize 'DND4E.Creature')}}:</label>
          {{#if isPlay}}
          <div class="actor-origin" data-tooltip="{{localize 'DND4E.Creature'}}">{{lookup (lookup config.creatureOrigin document.system.details.origin) "label"}}</div>
          {{else}}
          {{formInput detailsFields.origin value=source.system.details.origin}}
          {{/if}}
        </div>
        <div class="detail form-group creature-type">
          <label>{{localize 'DND4E.ThingType' thing=(localize 'DND4E.Creature')}}:</label>
          {{#if isPlay}}
          <div class="actor-type" data-tooltip="{{localize 'DND4E.ThingType' thing=(localize 'DND4E.Creature')}}">{{lookup (lookup config.creatureType document.system.details.type) "label"}}</div>
          {{else}}
          {{formInput detailsFields.type value=source.system.details.type}}
          {{/if}}
        </div>
        <div class="detail subtypes">
          {{#if (or (not isPlay) document.system.details.other)}}
          <label for="subtypes">{{localize 'DND4E.ThingSubtypes' thing=(localize 'DND4E.Creature')}}:</label>
          {{/if}}
          {{#if (and isPlay document.system.details.other)}}
          <div class="subtypes" data-tooltip="{{localize 'DND4E.ThingSubtypes' thing=(localize 'DND4E.Creature')}}">{{document.system.details.other}}</div>
          {{else}}
          {{formInput detailsFields.other value=source.system.details.other}}
          {{/if}}
        </div>
      </div>

    </div>
  </section>

  {{!-- Proficiency --}}
  {{#if (and isPlay shouldShowProficiencies)}}
  <div class="traits proficiencies">
    <h4 class="group-header">{{ localize 'DND4E.Proficiencies' }}</h4>

    {{#if shouldShowWeaponProf}}
    <div class="traits-row" data-tooltip="{{ localize 'DND4E.ProficienciesVar' type=(localize 'DND4E.Weapon')}}">
      <span class="subgroup-header label">{{ localize 'DND4E.Weapon' }}</span>
      <ul class="traits-list proficiency weapons">
        {{#each weaponProfs.selected as |v k|}}
        <li class="tag {{k}}">{{v}}</li>
        {{/each}}
      </ul>
    </div>
    {{/if}}

    {{#if shouldShowImplementProf}}
    <div class="traits-row" data-tooltip="{{ localize 'DND4E.ProficienciesVar' type=(localize 'DND4E.Implement')}}">
      <span class="subgroup-header label">{{ localize 'DND4E.Implement' }}</span>
      <ul class="traits-list proficiency implements">
        {{#each implementProfs.selected as |v k|}}
        <li class="tag {{k}}">{{v}}</li>
        {{/each}}
      </ul>
    </div>
    {{/if}}

    {{#if shouldShowArmourProf}}
    <div class="traits-row" data-tooltip="{{ localize 'DND4E.ProficienciesVar' type=(localize 'DND4E.Armour')}}">
      <span class="subgroup-header label">{{ localize 'DND4E.Armour' }}</span>
      <ul class="traits-list proficiency armour">
        {{#each armourProfs.selected as |v k|}}
        <li class="tag {{k}}">{{v}}</li>
        {{/each}}
      </ul>
    </div>
    {{/if}}
  </div>
  {{else if (not isPlay)}}
  <div class="traits proficiencies">
    <h4 class="group-header">{{ localize 'DND4E.Proficiencies' }}</h4>

    <div class="traits-row" data-tooltip="{{ localize 'DND4E.ProficienciesVar' type=(localize 'DND4E.Weapon')}}">
      <a class="trait-selector-weapon" data-action="traitSelectorWeapon" data-options="weaponProf" data-target="system.details.weaponProf" data-app-title="{{ localize 'DND4E.ProficienciesVar' type=(localize 'DND4E.Weapon')}}">
        <span class="subgroup-header label">{{ localize 'DND4E.Weapon' }}</span>
        <i class="fas fa-edit"></i>
      </a>
      <ul class="traits-list proficiency weapons">
        {{#each weaponProfs.selected as |v k|}}
        <li class="tag {{k}}">{{v}}</li>
        {{/each}}
      </ul>
    </div>

    <div class="traits-row" data-tooltip="{{ localize 'DND4E.ProficienciesVar' type=(localize 'DND4E.Implement')}}">
      <a class="trait-selector" data-action="traitSelector" data-options="implementProficiencies" data-target="system.details.implementProf" data-app-title="{{ localize 'DND4E.ProficienciesVar' type=(localize 'DND4E.Implement')}}">
        <span class="subgroup-header label">{{ localize 'DND4E.Implement' }}</span>
        <i class="fas fa-edit"></i>
      </a>
      <ul class="traits-list proficiency implements">
        {{#each implementProfs.selected as |v k|}}
        <li class="tag {{k}}">{{v}}</li>
        {{/each}}
      </ul>
    </div>

    <div class="traits-row" data-tooltip="{{ localize 'DND4E.ProficienciesVar' type=(localize 'DND4E.Armour')}}">
      <a class="trait-selector" data-action="traitSelector" data-options="profArmor" data-target="system.details.armourProf" data-app-title="{{ localize 'DND4E.ProficienciesVar' type=(localize 'DND4E.Armour')}}">
        <span class="subgroup-header label">{{ localize 'DND4E.Armour' }}</span>
        <i class="fas fa-edit"></i>
      </a>
      <ul class="traits-list proficiency armour">
        {{#each armourProfs.selected as |v k|}}
        <li class="tag {{k}}">{{v}}</li>
        {{/each}}
      </ul>
    </div>
  </div>
  {{/if}}

  {{!-- Languages --}}
  {{#if (and isPlay shouldShowLanguages)}}
  <div class="traits languages">
    <h4 class="group-header">{{ localize 'DND4E.Languages' }}</h4>

    <div class="traits-row">
      <span class="subgroup-header label">{{ localize 'DND4E.Spoken' }}</span>
      <ul class="traits-list languages spoken">
        {{#each languages.spoken.selected as |v k|}}
        <li class="tag {{k}}">{{v}}</li>
        {{/each}}
      </ul>
    </div>

    <div class="traits-row">
      <span class="subgroup-header label">{{ localize 'DND4E.Script' }}</span>
      <ul class="traits-list languages script">
        {{#each languages.script.selected as |v k|}}
        <li class="tag {{k}}">{{v}}</li>
        {{/each}}
      </ul>
    </div>
  </div>

  {{else if (not isPlay)}}
  <div class="traits languages">
    <h4 class="group-header">{{ localize 'DND4E.Languages' }}</h4>

    <div class="traits-row">
      <a class="trait-selector" data-action="traitSelector" data-options="spoken" data-target="system.languages.spoken" data-app-title="{{ localize 'DND4E.Spoken' }} {{ localize 'DND4E.Languages' }}">
        <span class="subgroup-header label">{{ localize 'DND4E.Spoken' }}</span>
        <i class="fas fa-edit"></i>
      </a>
      <ul class="traits-list languages spoken">
        {{#each languages.spoken.selected as |v k|}}
        <li class="tag {{k}}">{{v}}</li>
        {{/each}}
      </ul>
    </div>

    <div class="traits-row">
      <a class="trait-selector" data-action="traitSelector" data-options="script" data-target="system.languages.script" data-app-title="{{ localize 'DND4E.Script' }} {{ localize 'DND4E.Languages' }}">
        <span class="subgroup-header label">{{ localize 'DND4E.Script' }}</span>
        <i class="fas fa-edit"></i>
      </a>
      <ul class="traits-list languages script">
        {{#each languages.script.selected as |v k|}}
        <li class="tag {{k}}">{{v}}</li>
        {{/each}}
      </ul>
    </div>
  </div>
  {{/if}}

  {{!-- Senses --}}
  {{#if (or (not isPlay) shouldShowSenses)}}
  <div class="traits senses">
    <h4 class="group-header">{{ localize 'DND4E.Senses' }}</h4>
    {{#if (or (not isPlay) shouldShowSpecialSenses)}}
    <div class="traits-row">
      {{#if (not isPlay)}}<a class="trait-selector-senses" data-action="traitSelectorSenses" data-options="senses" data-target="system.senses.special" data-app-title="{{ localize 'DND4E.Senses' }}">{{/if}}
        <span class="subgroup-header label">{{ localize 'DND4E.Senses' }}</span>
      {{#if (not isPlay)}}
        <i class="fas fa-edit"></i>
      </a>
      {{/if}}
      <ul class="traits-list senses">
        {{#each senses.special.selected as |v k|}}
        <li class="tag {{k}}">{{v}}</li>
        {{/each}}
      </ul>
    </div>
    {{/if}}
    {{#if (and isPlay shouldShowSensesNotes)}}
    <div class="senses-arbitrary no-mono" data-tooltip="{{localize 'DND4E.OtherNotes'}}">{{system.senses.notes}}</div>
    {{else if (not isPlay)}}
    <textarea class="senses-arbitrary no-mono" name="source.system.senses.notes" data-tooltip="{{localize 'DND4E.OtherNotes'}}" placeholder="{{localize 'DND4E.OtherNotes'}}">{{source.system.senses.notes}}</textarea>
    {{/if}}
  </div>
  {{/if}}
</section>
